{
  "name": "starlit-apprentice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "godot:gate": "bash scripts/godot_quality_gate.sh --project .",
    "godot:core": "python3 scripts/run_godot.py --log build/qa/core.log -- godot --headless --path . --script res://tests/core_test_runner.gd",
    "godot:smoke": "python3 scripts/run_godot.py --log build/qa/smoke.log -- godot --headless --path . --script res://tests/test_runner.gd",
    "godot:arch": "python3 tools/check_core_boundary.py .",
    "godot:web": "bash scripts/export_web.sh .",
    "godot:budget": "bash scripts/check_web_budget.sh .",
    "godot:test": "bash scripts/test_all.sh",
    "godot:docs": "bash scripts/check_docs.sh .",
    "art:finalize": "bash scripts/finalize_art.sh assets/art",
    "test:e2e": "bash scripts/test_all.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "description": "별빛 견습생 — Godot 게임. npm은 정적 검증 도구 실행에 사용한다."
}
